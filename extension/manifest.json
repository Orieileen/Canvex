{
  "manifest_version": 3,
  "name": "Canvex RPA (dev)",
  "version": "0.1.0",
  "description": "Run Canvex RPA robots in YOUR own browser — real IP, real fingerprint, real login state. Stage-0 prototype.",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "debugger"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost:5199/*", "http://localhost:5173/*"],
      "js": ["canvas-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Canvex RPA" }
}
