# ╔══════════════════════════════════════════════════════════════════╗
# ║  Canvex —— 环境变量模板                                           ║
# ║  Django + DRF + Celery + Redis + Postgres + Canvas(LLM + 媒体)   ║
# ║  复制本文件为 .env 后填值。docker compose 用根目录 ./.env。        ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Django ──
DJANGO_SECRET_KEY=change-me-please
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# DJANGO_TIME_ZONE=UTC
CORS_ALLOW_ALL_ORIGINS=true
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:28000

# ── Postgres ──
POSTGRES_DB=canvex
POSTGRES_USER=canvex
POSTGRES_PASSWORD=canvex
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis / Celery ──
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# ── 端口 ──
BACKEND_PORT=28000
FRONTEND_PORT=5173


# ╔══════════════════════════════════════════════════════════════════╗
# ║  Canvas —— LLM Agent + 媒体生成(studio app)                      ║
# ║  长任务走独立 celery queue:canvas(gevent)/ canvas_cpu(rembg)   ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── 供应商(聊天 / 生图 / Angle 视角图 / 视频)──
# 这四块**都不在这里配**:端点、API key、模型名、请求参数全部在界面上填 ——
# 左侧栏「配置供应商」。可以配多个供应商、多个模型,生成时在工具栏切换。
# 聊天那条是[必填]的:没有它聊天框直接报错,而且它必须支持 OpenAI 的 tools 参数
# (接错了 agent 会回一段 markdown、画布上什么都不发生),别跟生图共用一把 key。
#
# 从旧版本升级上来的:原来的 CANVAS_CHAT_* / CANVAS_IMAGE_PRIMARY_* /
# CANVAS_IMAGE_FALLBACK_* / CANVAS_ANGLE_FAL_* / CANVAS_VIDEO_* 会被迁移
# (0008 / 0010 / 0013 / 0015)自动导进库,导完这些变量就不再读了,可以从 .env 里删掉。

# ── Agent 记忆 ──
# agent /memories/ 后端:memory(默认,重启丢)| postgres(跨进程持久)
# CANVAS_AGENT_STORE_BACKEND=memory

# ── 媒体公网基址 ──
# 图生图 / 视频 / angle(provider 要回拉源图)需公网可达 URL(ngrok / CDN);
# 纯文生图不需要。dev 默认 http://localhost:28000。
# PUBLIC_MEDIA_BASE=http://localhost:28000
# INTERNAL_MEDIA_BASE=http://backend:8000


# ╔══════════════════════════════════════════════════════════════════╗
# ║  前端(Vite 注入)                                                ║
# ╚══════════════════════════════════════════════════════════════════╝
VITE_API_URL=http://localhost:28000
VITE_CANVEX_ASSET_PATH=/canvex-assets/
