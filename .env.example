# ╔══════════════════════════════════════════════════════════════════╗
# ║  Canvex —— 环境变量模板                                           ║
# ║  Django + DRF + Celery + Redis + Postgres + Canvas(LLM + 媒体)   ║
# ║  复制本文件为 .env 后填值。docker compose 用根目录 ./.env。        ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Django ──
DJANGO_SECRET_KEY=change-me-please
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# DJANGO_TIME_ZONE=UTC
CORS_ALLOW_ALL_ORIGINS=true
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:28000

# ── Postgres ──
POSTGRES_DB=canvex
POSTGRES_USER=canvex
POSTGRES_PASSWORD=canvex
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis / Celery ──
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# ── 端口 ──
BACKEND_PORT=28000
FRONTEND_PORT=5173


# ╔══════════════════════════════════════════════════════════════════╗
# ║  Canvas —— LLM Agent + 媒体生成(studio app)                      ║
# ║  长任务走独立 celery queue:canvas(gevent)/ canvas_cpu(rembg)   ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Chat agent(deepagents;[必填] 必须用支持 tools 的 provider)──
CANVAS_CHAT_API_KEY=
CANVAS_CHAT_BASE_URL=
CANVAS_CHAT_MODEL=gpt-4o-mini
# agent /memories/ 后端:memory(默认,重启丢)| postgres(跨进程持久)
# CANVAS_AGENT_STORE_BACKEND=memory

# ── Agentic 浏览器工具 browse(可选,默认关)──
# 打开后 agent 会有一个 browse 工具,能自主浏览网页做调研/取参考图,截图落素材库,
# 摘要当轮返回给 agent。需装可选依赖:
#   pip install -r requirements-browser.txt && python -m playwright install chromium
# CANVAS_BROWSER_ENABLED=true
# 浏览器 LLM 槽(留空则回落主聊天模型 CANVAS_CHAT_*;browser-use 走 DOM 无需视觉模型)
# CANVAS_BROWSER_API_KEY=
# CANVAS_BROWSER_BASE_URL=
# CANVAS_BROWSER_MODEL=
# 安全护栏:白名单=逗号分隔的可访问域名后缀。非空时由浏览器逐跳强制(无法强制则拒跑);
# 空=不做应用层域名限制(agent 可跟随导航到任意域名),靠基础设施层限制出网。
# 强烈建议生产环境设白名单 + 基础设施层限制出网。
# CANVAS_BROWSER_ALLOWLIST=amazon.com,google.com
# 硬边界:单次浏览的步数 / 墙钟秒数上限(防止卡死当前对话轮)+ 最多落几张截图。
# CANVAS_BROWSER_MAX_STEPS=25
# CANVAS_BROWSER_TIMEOUT_SECONDS=180
# CANVAS_BROWSER_MAX_SCREENSHOTS=4
# CANVAS_BROWSER_HEADLESS=true
# 进程级并发上限:同时最多几个 browse 在跑(每个会占一个 Web 线程直到超时)。超出立即
# 拒绝(不排队),防止突发把线程池占满 / 起过多 Chromium。默认 2(容纳一轮两个并行 browse)。
# CANVAS_BROWSER_MAX_CONCURRENCY=2
# ── web_operator 子代理(可选,默认关):确定性 Playwright 原语,agent 分步驱动浏览器 ──
# (navigate/snapshot/click/type,与自主的 browse 互补;复用同一套依赖 + 模型槽)
# CANVAS_BROWSER_OPERATOR_ENABLED=true
# CANVAS_BROWSER_OP_TIMEOUT=30              # 单步浏览器操作超时(秒)
# CANVAS_BROWSER_SESSION_IDLE_TIMEOUT=300   # 会话空闲多久自动回收(秒,兜底;主清理在 turn 末)
# 容器内以 root 跑无头 Chromium 时需要(会削弱沙箱,仅容器内用):
# CANVAS_BROWSER_CHROMIUM_ARGS=--no-sandbox
# 状态改变门:表单提交(browser_type submit=True 的回车)默认禁用——字段仍会填,但不提交。
# 需要 operator 能提交表单时才开(注意:按钮点击式提交不在此门内,靠白名单+只读提示兜底):
# CANVAS_BROWSER_OPERATOR_ALLOW_SUBMIT=true

# ── 生图 · 主通道([必填];走 {prefix}_* 前缀,未配 key 时回退 OPENAI_*)──
CANVAS_IMAGE_PRIMARY_API_KEY=
CANVAS_IMAGE_PRIMARY_BASE_URL=
CANVAS_IMAGE_PRIMARY_MODEL=
# CANVAS_IMAGE_PRIMARY_IMAGE_FIELD=image_urls
# CANVAS_IMAGE_PRIMARY_RESPONSE_FORMAT=b64_json
# 异步轮询型供应商(如果你的供应商需要异步轮询获取结果):
# CANVAS_IMAGE_PRIMARY_POLL_ENABLED=true
# CANVAS_IMAGE_PRIMARY_POLL_MAX_ATTEMPTS=240
# CANVAS_IMAGE_PRIMARY_POLL_INTERVAL=5
# 可选回退(主通道未配 key 时用):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ── 生图 · 兜底通道(可选;主通道失败才切)──
# CANVAS_IMAGE_FALLBACK_API_KEY=
# CANVAS_IMAGE_FALLBACK_BASE_URL=
# CANVAS_IMAGE_FALLBACK_MODEL=

# ── 视频(可选;OpenAI 兼容 /videos)──
# CANVAS_VIDEO_BASE_URL=
# CANVAS_VIDEO_API_KEY=
# CANVAS_VIDEO_MODEL=

# ── Angle 视角图(可选;fal.ai)──
# CANVAS_ANGLE_FAL_API_KEY=
# CANVAS_ANGLE_FAL_BASE_URL=https://fal.run
# CANVAS_ANGLE_FAL_MODEL=fal-ai/qwen-image-edit-2511-multiple-angles

# ── 媒体公网基址 ──
# 图生图 / 视频 / angle(provider 要回拉源图)需公网可达 URL(ngrok / CDN);
# 纯文生图不需要。dev 默认 http://localhost:28000。
# PUBLIC_MEDIA_BASE=http://localhost:28000
# INTERNAL_MEDIA_BASE=http://backend:8000


# ╔══════════════════════════════════════════════════════════════════╗
# ║  前端(Vite 注入)                                                ║
# ╚══════════════════════════════════════════════════════════════════╝
VITE_API_URL=http://localhost:28000
VITE_CANVEX_ASSET_PATH=/canvex-assets/
